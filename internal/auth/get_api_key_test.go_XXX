package auth

import (
    "reflect"
    "testing"
)

func TestGetAPIKey(t *testing.T) {
    got := GetAPIKey("Unauthorized")
    //want := []string{"a", "b", "c"}
    want := []string{"malformed authorization header"}
    if !reflect.DeepEqual(want, got) {
         t.Fatalf("expected: %v, got: %v", want, got)
    }
}
